{
  "name": "ContinuityFlag",
  "type": "object",
  "properties": {
    "sequenceId": {
      "type": "string"
    },
    "fromShotId": {
      "type": "string"
    },
    "toShotId": {
      "type": "string"
    },
    "dimension": {
      "type": "string",
      "enum": [
        "wardrobe",
        "lighting",
        "character",
        "environment",
        "timeOfDay"
      ]
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "accepted",
        "fixed"
      ],
      "default": "open"
    }
  },
  "required": [
    "sequenceId",
    "fromShotId",
    "toShotId"
  ]
}